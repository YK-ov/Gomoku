							},
							"lineStyle": 2,
							"points": "235:653;316:653",
							"showVisibility": true,
							"nameLabel": {
								"$ref": "AAAAAAGhmGFvdUhZ40M="
							},
							"stereotypeLabel": {
								"$ref": "AAAAAAGhmGFvdkhaRu0="
							},
							"propertyLabel": {
